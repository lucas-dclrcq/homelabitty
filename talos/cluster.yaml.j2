---
version: v1alpha1
debug: false
persist: true
machine:
  token: {{ trustdinfo.token }}
  ca:
    crt: {{ certs.os.crt }}
    key: ""
  certSANs:
    - 192.168.42.42
    - k8s.lulice.lan
    - 127.0.0.1 # KubePrism
  # Stays in v1alpha1: KubeletConfig has no extraMounts (needed by OpenEBS hostpath)
  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.37.2
    extraArgs:
      image-gc-high-threshold: "55"
      image-gc-low-threshold: "50"
      rotate-server-certificates: "true"
    extraConfig:
      crashLoopBackOff:
        maxContainerRestartPeriod: 60s
      imageMaximumGCAge: 168h
      maxParallelImagePulls: 3
      serializeImagePulls: false
      shutdownGracePeriod: 90s
      shutdownGracePeriodCriticalPods: 60s
    extraMounts:
      - destination: /var/openebs/local
        type: bind
        source: /var/openebs/local
        options: ["bind", "rshared", "rw"]
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
  features:
    diskQuotaSupport: true
cluster:
  # Cannot move to KubeClusterConfig until .cluster.serviceAccount moves to KubeServiceAccountConfig
  controlPlane:
    # Static A record on the UDM -> 192.168.42.42, the Cilium kube-api
    # LoadBalancer (kube-system/kube-api). In-cluster components go through
    # KubePrism (127.0.0.1:7445) and never depend on this endpoint.
    endpoint: https://k8s.lulice.lan:6443
  clusterName: hoohoot
  token: {{ secrets.bootstraptoken }}
  ca:
    crt: {{ certs.k8s.crt }}
    key: ""
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/{{ schematic }}:v1.14.5
provisioning:
  diskSelector:
    match: disk.transport == "nvme"
  wipe: false
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false # Spegel
  [plugins."io.containerd.cri.v1.runtime"]
    enable_unprivileged_ports = true
    enable_unprivileged_icmp = true
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  noatime=True
  nconnect=16
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: {{ cluster.id }}
clusterSecret: {{ cluster.secret }}
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
  disableDefault: true
hostDNS:
  enabled: true
  forwardKubeDNSToHost: false # Requires Cilium `bpf.masquerade: false`
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
    - ntp.lulice.lan
    - time.cloudflare.com
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "8192" # Watchdog
  fs.inotify.max_user_watches: "1048576" # Watchdog
  net.core.default_qdisc: fq # 2.5Gb/s
  net.core.rmem_max: "67108864" # 2.5Gb/s
  net.core.wmem_max: "67108864" # 2.5Gb/s
  net.ipv4.neigh.default.gc_thresh1: "4096" # ARP table, many pod/LB IPs
  net.ipv4.neigh.default.gc_thresh2: "8192" # ARP table, many pod/LB IPs
  net.ipv4.neigh.default.gc_thresh3: "16384" # ARP table, many pod/LB IPs
  net.ipv4.tcp_congestion_control: bbr # 2.5Gb/s
  net.ipv4.tcp_fastopen: "3" # TCP Fast Open
  net.ipv4.tcp_mtu_probing: "1" # Recover from PMTU blackholes
  net.ipv4.tcp_notsent_lowat: "131072" # Lower latency with large buffers
  net.ipv4.tcp_rmem: 4096 131072 67108864 # 2.5Gb/s
  net.ipv4.tcp_slow_start_after_idle: "0" # Keep cwnd on idle long-lived connections
  net.ipv4.tcp_window_scaling: "1" # 2.5Gb/s
  net.ipv4.tcp_wmem: 4096 65536 67108864 # 2.5Gb/s
  user.max_user_namespaces: "10000"
  vm.nr_hugepages: "1024"
---
apiVersion: v1alpha1
kind: SysfsConfig
params:
  devices.system.cpu.cpu0.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu1.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu2.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu3.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu4.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu5.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu6.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu7.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu8.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu9.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu10.cpufreq.energy_performance_preference: balance_power
  devices.system.cpu.cpu11.cpufreq.energy_performance_preference: balance_power
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 192.168.1.0/24
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.69.0.0/16
serviceSubnets:
  - 10.96.0.0/16
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - bond0-m0
bondMode: active-backup
mtu: 1500
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
---
# VPN
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.70
vlanID: 70
parent: bond0
mtu: 1500
---
# IOT
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.30
vlanID: 30
parent: bond0
mtu: 1500
