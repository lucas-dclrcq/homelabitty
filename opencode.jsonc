{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "litellm": {
        "type": "remote",
        "url": "https://litellm.hoohoot.xyz/mcp",
        "oauth": false,
        "headers": {
          "x-litellm-api-key": "Bearer {env:LITELLM_API_KEY}"
        }
      }
    }
  }
}
