{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana": {
      "type": "remote",
      "url": "https://grafana.mcp.hoohoot.org/mcp",
      "enabled": true
    },
    "unifi": {
      "type": "remote",
      "url": "https://unifi-network-mcp.hoohoot.xyz/mcp",
      "enabled": true
    },
    "vault": {
      "type": "remote",
      "url": "https://vault.mcp.hoohoot.org/mcp",
      "enabled": true
    },
    "konflate": {
      "type": "remote",
      "url": "https://konflate.hoohoot.org/mcp"
    },
    "homeassistant": {
      "type": "remote",
      "url": "https://hass.hoohoot.org/api/mcp",
      "headers": {
        "Authorization": "Bearer {env:HASS_TOKEN}"
      }
    }
  }
}
