{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana": {
      "type": "remote",
      "url": "https://grafana.mcp.hoohoot.org/mcp",
      "enabled": true
    },
    "unifi": {
      "type": "remote",
      "url": "https://unifi-network-mcp.hoohoot.xyz/mcp",
      "enabled": true
    },
    "vault": {
      "type": "remote",
      "url": "https://vault-mcp-server.hoohoot.xyz/mcp",
      "enabled": true,
      "headers": {
        "X-Vault-Token": "{env:VAULT_TOKEN}"
      }
    }
  }
}
