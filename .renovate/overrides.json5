{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Track mautrix-instagram ig- prefixed tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["dock.mau.dev/mautrix/meta"],
      matchFileNames: ["kubernetes/apps/matrix/mautrix-instagram/**"],
      versioning: "regex:^ig-v(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$",
    },
    {
      // Since Silo-Server/silo-server#3319 the build-N tags carry the omnibus
      // image (s6-overlay, bundled PostgreSQL/Redis, needs root), which cannot
      // run under this deployment's runAsUser/readOnlyRootFilesystem. The base
      // image we run is published only as <sha>-base, which renovate has no
      // version ordering for, so bump silo by hand.
      description: "Pin silo-server: only <sha>-base tags are usable, bump manually",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/silo-server/silo-server"],
      enabled: false,
    },
    {
      description: "Limit renovate image updates to once per week",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      schedule: ["on monday"],
    },
    {
      description: "Limit hermes-webui image updates to once per week",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/nesquena/hermes-webui"],
      schedule: ["on monday"],
    },
  ],
}
