{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Track mautrix-instagram ig- prefixed tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["dock.mau.dev/mautrix/meta"],
      matchFileNames: ["kubernetes/apps/matrix/mautrix-instagram/**"],
      versioning: "regex:^ig-v(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$",
    },
    {
      description: "Limit renovate image updates to once per week",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      schedule: ["on monday"],
    },
  ],
}
