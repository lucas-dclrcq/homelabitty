{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  hostRules: [
    {
      description: "Authenticate against the ocharted OCI registry",
      matchHost: "ocharted.hoohoot.org",
      hostType: "docker",
      allowInternal: true,
      username: "renovate",
      password: "{{ secrets.OCHARTED_PASSWORD }}",
    },
  ],
}
