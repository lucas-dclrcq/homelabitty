{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "ocharted: resolve authentik-operator versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/slashnephy.github.io/authentik-operator/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://slashnephy.github.io/authentik-operator"],
    },
    {
      description: "ocharted: resolve harbor versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/helm.goharbor.io/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://helm.goharbor.io"],
    },
    {
      description: "ocharted: resolve kubelet-csr-approver versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/postfinance.github.io/kubelet-csr-approver/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://postfinance.github.io/kubelet-csr-approver"],
    },
    {
      description: "ocharted: resolve metrics-server versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/kubernetes-sigs.github.io/metrics-server/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://kubernetes-sigs.github.io/metrics-server"],
    },
    {
      description: "ocharted: resolve node-feature-discovery versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/kubernetes-sigs.github.io/node-feature-discovery/charts/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://kubernetes-sigs.github.io/node-feature-discovery/charts"],
    },
    {
      description: "ocharted: resolve reflector versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/emberstack.github.io/helm-charts/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://emberstack.github.io/helm-charts/"],
    },
    {
      description: "ocharted: resolve matrix-synapse versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/ananace.gitlab.io/charts/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://ananace.gitlab.io/charts"],
    },
    {
      description: "ocharted: resolve rook-ceph-cluster versions from upstream",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.flux-system.svc.cluster.local:8080/charts.rook.io/release/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://charts.rook.io/release"],
    },
  ],
}
